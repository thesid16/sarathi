# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Model weights are large and licensed separately - never commit them.
# Manifests in models/manifests/ ARE committed; the binaries they point to are not.
models/weights/**
!models/weights/.gitkeep

# Datasets
datasets/**
!datasets/.gitkeep
training/datasets/**/images/
training/datasets/**/labels/

# Benchmark and run outputs
runs/
out/
*.log

# Recorded test footage (large). Keep the manifest, not the media.
docs/assets/footage/
*.mp4
*.mov
!docs/assets/**/*.png

# Android
android/.gradle/
android/local.properties
android/**/build/
*.apk
*.aab
*.keystore

# macOS
.DS_Store

# Android build outputs
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/

# The web demo's copy of the detector. 10 MB, and reproducible from
# models/weights - but committed anyway, because a demo that needs a build step
# before it will open is not a demo. See web/README.md.
!web/model/*.onnx
!web/model/*.txt

# The shipped APK. Committed deliberately: this project is handed to people as
# a file, not through a store, and "build it yourself first" is where the
# handover stops. 92 MB, mostly LiteRT-LM native libraries.
!sarathi.apk
